FLASK_ENV=development
FLASK_SECRET_KEY=dev-secret-change-me
APP_ACCESS_KEY=talentlens-dev-key

# Keep R2 buckets private. Set RESUME_STORAGE_BACKEND=r2 and fill all values to enable it.
RESUME_STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_OBJECT_PREFIX=resumes

AI_MODE=mock
AI_PROVIDER=openai
